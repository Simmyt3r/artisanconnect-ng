# ArtisanConnect NG — InfinityFree .htaccess

# Disable directory listing
Options -Indexes

# Protect sensitive files from direct browser access
<FilesMatch "\.(sql|log|txt|env|git)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Default charset
AddDefaultCharset UTF-8

# Custom error pages
ErrorDocument 404 /404.php
ErrorDocument 500 /500.php
